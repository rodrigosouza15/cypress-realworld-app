vite.cypress.config.ts

# Scripts auxiliares
scripts/
patches/
sandbox.config.json

# Versionamento / ambiente
.node-version
.nvmrc
.yarnrc
.prettierignore
.prettierrc

# Extras que não agregam ao portfólio
